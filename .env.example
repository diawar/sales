# Example only. Set these variables in the Django process environment.
# This project does not automatically read .env files.
# Set to 1 behind production HTTPS; keep 0 for local HTTP.
SALES_SECURE_COOKIES=0
SALES_SMTP_ENABLED=0
SALES_MAIL_PROVIDER=servercore
EMAIL_HOST=smtp.servercore-smtp.com
EMAIL_PORT=1126
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=sender@example.com
SALES_FROM_NAME=OVER
# Only your own test inboxes, comma-separated. No audience imports here.
SALES_TEST_RECIPIENTS=tester@example.com

# Public origin for confirmation/unsubscribe links; empty uses current local origin.
SALES_PUBLIC_BASE_URL=

# Servercore: this review stage blocks SMTP in code even if enabled above.
# Configure secrets only in the server process; never commit them or enter them into templates.
SERVERCORE_RESOURCE_ID=
SERVERCORE_SENDER_DOMAIN=
# Option A: project-scoped IAM token (expires after 24 hours).
SERVERCORE_IAM_TOKEN=
# Option B: service user; IAM token is renewed automatically before expiry.
# Leave SERVERCORE_IAM_TOKEN empty to use these credentials.
SERVERCORE_ACCOUNT_ID=
SERVERCORE_PROJECT_NAME=
SERVERCORE_SERVICE_USER=
SERVERCORE_SERVICE_PASSWORD=
