# Copy to /etc/over-sales/sales.env, root:root, mode 0600. Never commit the real file.
# Generate ONCE, privately; preserve across updates and restarts.
DJANGO_SECRET_KEY=
DJANGO_SETTINGS_MODULE=mailer.production
SALES_ALLOWED_HOSTS=sales.overclockers.kz,127.0.0.1
SALES_PUBLIC_BASE_URL=https://sales.overclockers.kz
SALES_DATA_DIR=/var/lib/over-sales
SALES_SMTP_ENABLED=0
# Existing PostgreSQL users: preserve all POSTGRES_* settings privately.
# Without POSTGRES_DB, the database is /var/lib/over-sales/contacts.sqlite3.
